# Copy this file to .env and fill in at least one API key
# Priority: GROQ > GEMINI > template fallback (no key needed)

# Groq API (free tier - https://console.groq.com)
GROQ_API_KEY=



# Google Gemini API (free tier - https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# Optional overrides
# GROQ_MODEL=llama-3.1-70b-versatile
# GEMINI_MODEL=gemini-1.5-flash
# SENTENCE_MODEL=all-MiniLM-L6-v2
# ML_PORT=8000
